PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=stock_agent
JWT_SECRET=stock-agent-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# redirect harus ke API (bukan Vite), tanpa spasi/kutip di ujung; sama persis dengan Google Console
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# kalau pernah buka API lewat 127.0.0.1, tambahkan URI yang sama di Console untuk host itu juga
# origin frontend untuk CORS + cookie (wajib selain * kalau pakai credentials)
CORS_ORIGIN=http://localhost:5173
# dipakai setelah login Google (redirect browser)
FRONTEND_URL=http://localhost:5173
# production HTTPS: set COOKIE_SECURE=true
# COOKIE_SECURE=true
# OpenAI API key untuk generate embedding
OPENAI_API_KEY=
