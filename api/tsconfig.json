{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@helper/*": ["src/modules/helper/*"],
      "@services/*": ["src/api/services/*"],
      "@lib/*": ["src/api/lib/*"],
      "@models": ["src/modules/models/index.ts"],
      "@models/*": ["src/modules/models/*"],
      "@database": ["src/modules/database.ts"]
    },
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"]
}
